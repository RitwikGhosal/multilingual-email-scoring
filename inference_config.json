{
  "base_model": "xlm-roberta-base",
  "tokenizer_dir": "models/hybrid_mean/tokenizer",
  "max_length": 384,
  "batch_size": 16,
  "projection_size": 256,
  "dropout": 0.1,
  "grammar_model": {
    "checkpoint_dir": "models/hybrid_cls",
    "pooling": "first_token",
    "heads_filename": "prediction_heads_epoch8.pt"
  },
  "content_cefr_model": {
    "checkpoint_dir": "models/hybrid_mean",
    "pooling": "masked_mean",
    "heads_filename": "prediction_heads_epoch8.pt",
    "calibration_file": "cefr_calibration.json"
  },
  "cefr_labels": [
    "A1",
    "A2",
    "B1",
    "B2",
    "C1",
    "C2"
  ]
}
